# --- Backend (Symfony) ---
APP_ENV=dev
# Wygeneruj własny: openssl rand -hex 32
APP_SECRET=dev-only-secret-change-me

# Konto demo tworzone przy starcie (bin/console app:seed). Zostaw puste, by go nie tworzyć.
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=Demo-pass-123

# Okno rezerwacji: koniec rezerwacji najdalej teraz + ten interwał (ISO 8601).
BOOKING_MAX_ADVANCE=P1Y
# Czas życia tokenu API (ISO 8601).
API_TOKEN_TTL=PT12H

# --- Docker Compose ---
BACKEND_PORT=8200
FRONTEND_PORT=3100
